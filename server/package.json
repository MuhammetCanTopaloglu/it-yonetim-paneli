{
  "name": "it-panel-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "seed:demo": "node --import tsx scripts/seed-demo.mjs",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "multer": "^2.4.0",
    "net-snmp": "^3.20.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
